# Groq API Key (the only external service)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (using openai/gpt-oss-120b as requested)
GROQ_MODEL=openai/gpt-oss-120b

# Local Embedding Model (runs 100% locally on CPU via Transformers.js)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Application Port
PORT=5000

# Local MongoDB Connection (used when running outside Docker)
MONGODB_URI=mongodb://127.0.0.1:27017/halden_rag
